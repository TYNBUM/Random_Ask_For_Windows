OPENAI_API_KEY=sk-your-key
# Optional: OpenAI-compatible endpoint, for example https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: override API access for "框选问".
VISION_OPENAI_API_KEY=
VISION_OPENAI_BASE_URL=
# Used by "框选问"; must support image input.
VISION_MODEL=qwen3-vl-flash

# Optional: override API access for "拖文本" and "剪贴板".
TEXT_OPENAI_API_KEY=
TEXT_OPENAI_BASE_URL=
# Used by "拖文本" and "剪贴板"; text-only model is enough.
TEXT_MODEL=qwen3.6-flash

LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2
